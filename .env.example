# BookBridge Platform — Environment Configuration Example

# Django Core Security
SECRET_KEY=django-insecure-bookbridge-change-this-in-production-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
# Set DB_ENGINE=postgresql to connect to PostgreSQL.
# Leave blank or set DB_ENGINE=sqlite to use local SQLite development database.
DB_ENGINE=postgresql
POSTGRES_DB=bookbridge_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Media & Static Files
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/
